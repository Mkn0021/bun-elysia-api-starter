PORT=3001

POSTGRES_URL=postgres://user:password@localhost:5432/ai_chatbot
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (used for ETag caching and resumable chat streams)
REDIS_URL=redis://localhost:6379

# Frontend origin, used for CORS once the frontend points at this backend
FRONTEND_URL=http://localhost:3000
